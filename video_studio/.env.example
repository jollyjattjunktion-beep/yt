# Copy to .env. Never commit real credentials.
APP_NAME=Preet Sports AI Video Studio
OUTPUT_DIR=./output
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional cricket-data adapter endpoint. Must return the JSON contract in README.
CRICKET_DATA_API_URL=
CRICKET_DATA_API_KEY=
# Edge TTS voice; change to another supported Indian English/Hindi voice if desired.
TTS_VOICE=en-IN-PrabhatNeural
TTS_RATE=+0%
FFMPEG_BIN=ffmpeg
YOUTUBE_CLIENT_SECRETS_FILE=./client_secret.json
YOUTUBE_TOKEN_FILE=./youtube_token.json
